{% extends 'base.html.twig' %}

{% block title %}Liste #{{ todo_list.id }} — TodoList{% endblock %}

{% block body %}
<div class="page-header">
    <h1>📋 Liste <span style="font-size:1.2rem;opacity:.6">#{{ todo_list.id }}</span></h1>
    <div class="actions">
        <a href="{{ path('app_todo_list_index') }}" class="btn btn-secondary">← Retour</a>
        <a href="{{ path('app_todo_list_edit', {'id': todo_list.id}) }}" class="btn btn-primary">✏️ Éditer</a>
    </div>
</div>

<div class="card" style="margin-bottom:1.5rem;">
    <div style="display:flex; gap:2rem; flex-wrap:wrap;">
        <div>
            <div style="font-size:.75rem;font-weight:600;text-transform:uppercase;letter-spacing:.06em;color:var(--text-muted);margin-bottom:.3rem;">Créée le</div>
            <div style="font-size:1rem;">{{ todo_list.createdAt ? todo_list.createdAt|date('d/m/Y à H:i') : '—' }}</div>
        </div>
        <div>
            <div style="font-size:.75rem;font-weight:600;text-transform:uppercase;letter-spacing:.06em;color:var(--text-muted);margin-bottom:.3rem;">Tâches</div>
            <span class="badge badge-cyan">{{ todo_list.listItems|length }} tâche(s)</span>
        </div>
    </div>
</div>

<div class="page-header" style="margin-top:2rem;">
    <h2 style="font-size:1.2rem;font-weight:600;">📝 Tâches de cette liste</h2>
    <a href="{{ path('app_list_item_new') }}" class="btn btn-primary btn-sm">＋ Ajouter une tâche</a>
</div>

<div class="card">
    {% if todo_list.listItems is empty %}
        <div class="empty-state">
            <div class="icon">📝</div>
            <p>Aucune tâche dans cette liste.</p>
        </div>
    {% else %}
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Titre</th>
                        <th>Créée le</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for item in todo_list.listItems %}
                    <tr>
                        <td style="font-weight:500;">{{ item.title }}</td>
                        <td style="color:var(--text-muted);font-size:.88rem;">{{ item.createdAt ? item.createdAt|date('d/m/Y à H:i') : '—' }}</td>
                        <td>
                            <div class="actions">
                                <a href="{{ path('app_list_item_show', {'id': item.id}) }}" class="btn btn-secondary btn-sm">👁 Voir</a>
                                <a href="{{ path('app_list_item_edit', {'id': item.id}) }}" class="btn btn-secondary btn-sm">✏️</a>
                            </div>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
</div>

<hr class="divider">

<form method="post" action="{{ path('app_todo_list_delete', {'id': todo_list.id}) }}" onsubmit="return confirm('Supprimer cette liste ?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ todo_list.id) }}">
    <button class="btn btn-danger">🗑 Supprimer cette liste</button>
</form>
{% endblock %}
