{{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
    {% for field in form %}
        {% if field.vars.name != '_token' %}
        <div class="form-group">
            <label for="{{ field.vars.id }}">{{ field.vars.label|default(field.vars.name|replace({'_': ' '})|capitalize) }}</label>
            {{ form_widget(field) }}
            {% if form_errors(field) is not empty %}
                <div style="color:var(--danger);font-size:.82rem;margin-top:.3rem;">{{ form_errors(field) }}</div>
            {% endif %}
        </div>
        {% endif %}
    {% endfor %}
    <button type="submit" class="btn btn-primary" style="width:100%;">{{ button_label|default('💾 Enregistrer') }}</button>
{{ form_end(form) }}
