{% extends 'base.html.twig' %}

{% block title %}Éditer tâche #{{ list_item.id }} — TodoList{% endblock %}

{% block body %}
<div class="page-header">
    <h1>✏️ Éditer tâche <span style="opacity:.6">#{{ list_item.id }}</span></h1>
    <a href="{{ path('app_list_item_show', {'id': list_item.id}) }}" class="btn btn-secondary">← Retour</a>
</div>

<div class="card" style="max-width:480px;">
    {{ include('list_item/_form.html.twig', {'button_label': '💾 Mettre à jour'}) }}
</div>

<hr class="divider" style="max-width:480px;">

{{ include('list_item/_delete_form.html.twig') }}
{% endblock %}
