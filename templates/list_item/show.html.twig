{% extends 'base.html.twig' %}

{% block title %}{{ list_item.title }} — TodoList{% endblock %}

{% block body %}
<div class="page-header">
    <h1>📝 Détail de la tâche</h1>
    <div class="actions">
        <a href="{{ path('app_list_item_index') }}" class="btn btn-secondary">← Retour</a>
        <a href="{{ path('app_list_item_edit', {'id': list_item.id}) }}" class="btn btn-primary">✏️ Éditer</a>
    </div>
</div>

<div class="card" style="max-width:560px;">
    <div style="margin-bottom:1.2rem;">
        <div style="font-size:.75rem;font-weight:600;text-transform:uppercase;letter-spacing:.06em;color:var(--text-muted);margin-bottom:.3rem;">#ID</div>
        <span class="badge badge-purple">#{{ list_item.id }}</span>
    </div>

    <div style="margin-bottom:1.2rem;">
        <div style="font-size:.75rem;font-weight:600;text-transform:uppercase;letter-spacing:.06em;color:var(--text-muted);margin-bottom:.3rem;">Titre</div>
        <div style="font-size:1.15rem;font-weight:600;">{{ list_item.title }}</div>
    </div>

    <div style="margin-bottom:1.2rem;">
        <div style="font-size:.75rem;font-weight:600;text-transform:uppercase;letter-spacing:.06em;color:var(--text-muted);margin-bottom:.3rem;">Liste parente</div>
        {% if list_item.todoList %}
            <a href="{{ path('app_todo_list_show', {'id': list_item.todoList.id}) }}" style="color:var(--accent2);text-decoration:none;font-weight:500;">
                📋 Liste #{{ list_item.todoList.id }}
            </a>
        {% else %}
            <span style="color:var(--text-muted);">Aucune liste associée</span>
        {% endif %}
    </div>

    <div>
        <div style="font-size:.75rem;font-weight:600;text-transform:uppercase;letter-spacing:.06em;color:var(--text-muted);margin-bottom:.3rem;">Créée le</div>
        <div>{{ list_item.createdAt ? list_item.createdAt|date('d/m/Y à H:i') : '—' }}</div>
    </div>

    <hr class="divider">

    {{ include('list_item/_delete_form.html.twig') }}
</div>
{% endblock %}
